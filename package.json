{
  "name": "tonup-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:soon": "SITE_MODE=coming-soon next dev",
    "build": "next build && tsx scripts/postbuild.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "tsx --test worker/*.test.ts src/lib/*.test.ts",
    "preview": "pnpm build && wrangler dev",
    "preview:branch": "tsx scripts/preview.ts",
    "deploy": "DEPLOY_TARGET=production pnpm build && wrangler deploy"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "wrangler": "4.152.0"
  }
}
